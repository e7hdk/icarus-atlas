{
  "id": "stichius-boeotian",
  "name": "Stichius",
  "greekName": "Stichius (Στίχιος)",
  "type": "hero",
  "domains": ["Boeotian leader", "brazen-coated Boeotians"],
  "cluster": "mortal-arm",
  "summary": [
    {
      "text": "Leader of the brazen-coated Boeotians whom Hector laid low when Apollo sent panic upon the Argives at the ships — a namesake of Stichius (`stichius-athenian`), captain of the picked Athenians in Book 13.",
      "sources": ["homer"],
      "citation": "Iliad 15.315–340"
    }
  ],
  "story": [
    {
      "text": "When the fight was scattered and Apollo roused the Trojans, Hector laid low Stichius — a leader of the brazen-coated Boeotians — and Arcesilaus (`arcesilaus`), the trusty comrade of great-souled Menestheus, in the press before the hollow ships.",
      "sources": ["homer"],
      "citation": "Iliad 15.315–340"
    }
  ],
