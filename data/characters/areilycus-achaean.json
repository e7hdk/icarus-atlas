{
  "id": "areilycus-achaean",
  "name": "Areilycus",
  "greekName": "Areilykos (Ἀρείλυκος)",
  "type": "hero",
  "domains": ["father of Prothoënor", "Boeotian house"],
  "cluster": "mortal-arm",
  "summary": [
    {
      "text": "Boeotian father of the captain Prothoënor, named when Polydamas speared his son at the ships — and in Hyginus' roll father of Arcesilaus and Prothoënor by Theobula; a namesake of the Trojan Areilycus whom Patroclus slew.",
      "sources": ["homer", "hyginus"],
      "citation": "Iliad 14.449–451; Fabulae 97"
    }
  ],
  "story": [
    {
      "text": "Polydamas cast and smote upon the right shoulder Prothoënor, son of Areïlycus, and through the shoulder the mighty spear held its way; and he fell in the dust and clutched the ground with his palm.",
      "sources": ["homer"],
      "citation": "Iliad 14.440–470"
    }
  ],
