{
  "chronographers": [
    {
      "id": "eratosthenes",
      "name": "Eratosthenes of Cyrene",
      "work": "Chronographiai (~225 BC)",
      "note": "First scientific chronography; counted backward from the Olympiads. The spine of this axis. Lost, reconstructed via Clement (Stromata 1.21) and Censorinus. Generational estimates (~30 yrs/generation back from Troy) follow his own method."
    },
    {
      "id": "marmor-parium",
      "name": "The Parian Marble",
      "work": "Marmor Parium, IG XII.5.444 (inscribed 264/3 BC)",
      "note": "An inscribed stele dating events backward from the archon Diognetus. Dates much of the heroic age the Eratosthenic spine leaves blank."
    },
    {
      "id": "eusebius",
      "name": "Eusebius (after Castor & Africanus)",
      "work": "Chronicle (~AD 311)",
      "note": "The synchronizing tradition that pushed the count back before Cecrops via the Sicyonian and Argive king-lists. Its invented god-reign dates are treated as legend, not date."
    }
  ],
