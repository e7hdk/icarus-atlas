# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local research corpus (reproducible via research/corpus/manifest.json)
/research/corpus/raw/
/research/corpus/normalized/
data/geo/raw/

# culture harvest candidates (reproducible via `pnpm harvest:culture <id>`)
/research/culture-candidates/

# festival research staging (docs/EPHEMERIS_PLAN.md M12.4)
/research/festivals/

# pinned terrain extract (~1.2 GB, reproducible via `pnpm dem:fetch`)
/public/geo/dem.pmtiles

# 256px terrain-mesh archive (reproducible via `pnpm dem:terrain`)
/public/geo/dem-terrain.pmtiles
/public/geo/dem-terrain.tmp.mbtiles

# baked relief raster tiles (reproducible via `pnpm relief:bake`) — the tiny
# manifest stays tracked so CI can build the relief source spec while the
# tiles themselves serve from the hosted geo base (GEO_ASSETS_BASE).
/public/geo/relief/*
!/public/geo/relief/manifest.json
