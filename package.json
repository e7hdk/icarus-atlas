{
  "name": "icarus-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:map && pnpm bake-layout && pnpm bake-linked-prose && next dev -p 3500",
    "build:fonts": "tsx scripts/build-map-fonts.ts",
    "build:map": "tsx scripts/build-map-fonts.ts && tsx scripts/build-map-style.ts",
    "bake-layout": "tsx scripts/bake-layout.ts",
    "bake-linked-prose": "tsx scripts/bake-linked-prose.ts",
    "sync:river-geometry": "tsx scripts/sync-river-geometry.ts",
    "rivers:base": "tsx scripts/build-rivers-base.ts",
    "fetch:osm-rivers": "tsx scripts/fetch-osm-rivers.ts",
    "refresh:rivers": "tsx scripts/refresh-river-geometry.ts",
    "build": "pnpm build:map && pnpm bake-layout && pnpm bake-linked-prose && next build",
    "start": "next start",
    "lint": "eslint",
    "dem:fetch": "pmtiles extract https://download.mapterhorn.com/planet.pmtiles public/geo/dem.pmtiles --bbox=-6,22,44,47 --maxzoom=9",
    "dem:terrain": "tsx scripts/build-terrain-dem.ts",
    "relief:bake": "tsx scripts/bake-relief.ts",
    "corpus:sync": "tsx scripts/corpus-sync.ts sync",
    "corpus:verify": "tsx scripts/corpus-sync.ts verify",
    "corpus:search": "tsx scripts/corpus-search.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "verify:culture": "tsx scripts/verify-culture-links.ts",
    "harvest:culture": "tsx scripts/harvest-culture.ts",
    "validate-layout": "tsx scripts/validate-layout.ts",
    "validate-ephemeris": "tsx scripts/validate-ephemeris.ts",
    "bake-attic-calendar": "tsx scripts/build-attic-calendar.ts",
    "audit:residences": "tsx scripts/audit-city-residences.ts",
    "theogony:gap": "tsx scripts/theogony-gap.ts",
    "water-nymph:gap": "tsx scripts/water-nymph-gap.ts",
    "build-sky": "tsx scripts/build-sky.ts",
    "test:palimpsest": "tsx --test src/features/palimpsest/*.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.9",
    "pmtiles": "^4.4.1",
    "postprocessing": "6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@turf/bbox-clip": "^7.3.5",
    "@turf/bbox-polygon": "^7.3.5",
    "@turf/boolean-intersects": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "astronomy-engine": "^2.1.19",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pbf": "^5.1.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
